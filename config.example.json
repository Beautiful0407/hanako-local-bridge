{
  "schemaVersion": 1,
  "device": {
    "id": "my-windows-pc",
    "name": "My Windows PC"
  },
  "filesystem": {
    "host": "127.0.0.1",
    "port": 8787,
    "approvalPort": 8788,
    "trustMode": "full",
    "roots": [
      {
        "name": "MyFiles",
        "path": "%USERPROFILE%",
        "mode": "read_write"
      },
      {
        "name": "HanakoLocalBridge",
        "path": "%INSTALLDIR%",
        "mode": "read"
      }
    ]
  },
  "storage": {
    "dataDir": "data",
    "logDir": "logs"
  },
  "cloud": {
    "enabled": true,
    "url": "wss://your-server.example.com/local-bridge/connect"
  },
  "update": {
    "manifest": "https://your-server.example.com/local-bridge/releases/update-manifest.json",
    "channel": "stable"
  }
}
