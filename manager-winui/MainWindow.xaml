<Window
    x:Class="HanakoBridgeManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HanakoBridgeManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="Hanako Local Bridge 管理器">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,148,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="22"
                Height="22"
                CornerRadius="5"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE950;"
                    FontSize="12"
                    Foreground="White" />
            </Border>

            <Grid
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Hanako Local Bridge"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleDeviceText"
                    Grid.Column="1"
                    Text="正在检测"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <ProgressRing
                x:Name="HeaderProgress"
                Grid.Column="2"
                Width="18"
                Height="18"
                Margin="0,0,12,0"
                IsActive="False"
                Visibility="Collapsed" />

            <Border
                x:Name="OverallBadge"
                Grid.Column="3"
                MinWidth="82"
                Height="28"
                Padding="12,0"
                CornerRadius="6"
                Background="#5F6368">
                <TextBlock
                    x:Name="OverallBadgeText"
                    Text="检测中"
                    Foreground="White"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <ToggleButton
                x:Name="ThemeToggle"
                Grid.Column="4"
                Width="36"
                Height="32"
                Margin="8,0,0,0"
                Click="ThemeToggle_Click"
                ToolTipService.ToolTip="切换深色模式">
                <FontIcon Glyph="&#xE708;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <muxc:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="172"
            CompactPaneLength="52"
            SelectionChanged="Navigation_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem
                    x:Name="OverviewNavItem"
                    Content="概览"
                    Tag="overview">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem
                    x:Name="DiagnosticsNavItem"
                    Content="诊断与修复"
                    Tag="diagnostics">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem
                    x:Name="DevicesNavItem"
                    Content="云端设备"
                    Tag="devices">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem
                    x:Name="LogsNavItem"
                    Content="日志"
                    Tag="logs">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="设置"
                    Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalInfoBar"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsClosable="True"
                    IsOpen="False" />

                <Grid Grid.Row="1">
                    <ScrollViewer
                        x:Name="OverviewPage"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Grid Padding="28,18,28,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="运行概览"
                                    FontSize="28"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OverviewSubtitle"
                                    Text="正在读取本地服务状态"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,22,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="16"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE968;"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="本地 MCP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="McpTileText" Text="检测中" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="16"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE753;"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="云端连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CloudTileText" Text="检测中" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE8D7;"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="设备凭证" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CredentialTileText" Text="检测中" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="3"
                                    Padding="16"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE7F8;"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="后台任务" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TaskTileText" Text="检测中" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="18"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid RowSpacing="14" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="本机服务" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="设备 ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DeviceIdText" Grid.Row="1" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="设备名称" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DeviceNameText" Grid.Row="2" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="3" Text="版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="4" Text="MCP 端口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="McpPortText" Grid.Row="4" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="5" Text="状态端口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="StatusPortText" Grid.Row="5" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="6" Text="访问模式" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TrustModeText" Grid.Row="6" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="7" Text="服务进程" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="ProcessText" Grid.Row="7" Grid.Column="1" Text="-" />
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="18"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid RowSpacing="14" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="云端连接" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="连接状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CloudStatusText" Grid.Row="1" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="2" Text="云端地址" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CloudUrlText" Grid.Row="2" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="3" Text="连接时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LastConnectedText" Grid.Row="3" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="4" Text="最后心跳" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LastSeenText" Grid.Row="4" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="5" Text="最近错误" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CloudErrorText" Grid.Row="5" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="6" Text="公钥指纹" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="FingerprintText" Grid.Row="6" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="7" Text="建议" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="RecommendationText" Grid.Row="7" Grid.Column="1" Text="-" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
                                <Button Click="RefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="刷新" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StartButton" Click="StartButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Click="StopButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="停止" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestartButton" Click="RestartButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="重启" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RepairButton" Style="{ThemeResource AccentButtonStyle}" Click="RepairButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                        <TextBlock Text="检测并修复" />
                                    </StackPanel>
                                </Button>
                                <Button Click="SettingsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                                        <TextBlock Text="设置" />
                                    </StackPanel>
                                </Button>
                                <Button Click="StatusPageButton_Click" Content="本地状态页" />
                                <Button Click="WebButton_Click" Content="Hana 网页端" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid
                        x:Name="DiagnosticsPage"
                        Padding="28,18,28,28"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="诊断与修复" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="检查后台任务、隐藏启动器、本地端口、云端连接与设备凭证" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,18,0,12" Orientation="Horizontal" Spacing="8">
                            <Button Click="RefreshButton_Click" Content="重新检测" />
                            <Button Style="{ThemeResource AccentButtonStyle}" Click="RepairButton_Click" Content="一键修复" />
                            <Button Click="CopyReportButton_Click" Content="复制诊断报告" />
                        </StackPanel>
                        <ListView
                            Grid.Row="2"
                            ItemsSource="{x:Bind Diagnostics}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid
                        x:Name="DevicesPage"
                        Padding="28,18,28,28"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="云端设备" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="查询已认领电脑，或为当前电脑完成首次认领" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CloudBaseUrlBox"
                                Header="Hana 网页地址"
                                PlaceholderText="https://154-201-69-202.sslip.io" />
                            <PasswordBox
                                x:Name="AccessKeyBox"
                                Grid.Column="1"
                                Header="网页访问密钥"
                                PlaceholderText="仅本次使用" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,12,0,12" Orientation="Horizontal" Spacing="8">
                            <Button Click="QueryDevicesButton_Click" Content="查询云端设备" />
                            <Button Style="{ThemeResource AccentButtonStyle}" Click="ClaimDeviceButton_Click" Content="登录并认领本机" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="访问密钥不会保存到磁盘。" />
                        </StackPanel>

                        <Grid Grid.Row="3" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备 ID" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="设备名称" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="版本" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="状态" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="最后在线" FontWeight="SemiBold" />
                        </Grid>

                        <ListView
                            Grid.Row="4"
                            ItemsSource="{x:Bind CloudDevices}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding LastSeen}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid
                        x:Name="LogsPage"
                        Padding="28,18,28,28"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="运行日志" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="查看 MCP、watchdog 和旧隧道的本机日志" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,18,0,12" Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="LogFileCombo"
                                Width="360"
                                ItemsSource="{x:Bind LogFiles}"
                                DisplayMemberPath="Name"
                                SelectionChanged="LogFileCombo_SelectionChanged" />
                            <Button Click="RefreshLogsButton_Click" Content="刷新日志" />
                            <Button Click="OpenLogsButton_Click" Content="打开日志目录" />
                        </StackPanel>
                        <TextBox
                            x:Name="LogTextBox"
                            Grid.Row="2"
                            Padding="14"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            FontSize="13"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Background="#15181B"
                            Foreground="#E4E8EC" />
                    </Grid>

                    <ScrollViewer
                        x:Name="SettingsPage"
                        Padding="28,18,28,28"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="管理连接配置，并检查文件桥的在线更新"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border
                                Padding="18"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="连接与文件夹" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="打开现有设置窗口，修改云端地址、访问密钥、授权模式和本地根目录。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <Button Click="SettingsButton_Click" Content="打开连接与文件夹设置" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="18"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="在线更新" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="更新清单会经过签名校验，安装时会保留配置、设备身份、数据和日志。"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="UpdateStatusText"
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="尚未检查"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnSpacing="18" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="当前版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="UpdateCurrentVersionText" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="1" Text="最新版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="UpdateLatestVersionText" Grid.Row="1" Grid.Column="1" Text="-" />
                                        <TextBlock Grid.Row="2" Text="签名校验" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="UpdateSignatureText" Grid.Row="2" Grid.Column="1" Text="-" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="UpdateNotesText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="CheckUpdateButton"
                                            Click="CheckUpdateButton_Click"
                                            Content="检查更新" />
                                        <Button
                                            x:Name="InstallUpdateButton"
                                            Click="InstallUpdateButton_Click"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Content="立即安装" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FooterStatusText"
                        VerticalAlignment="Center"
                        Text="就绪"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="FooterRefreshText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
